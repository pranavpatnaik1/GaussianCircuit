# GAUSSIANCIRCUIT_COLMAP=C:\path\to\COLMAP.bat
# The project-local tools/openmvs installation is auto-detected.
# GAUSSIANCIRCUIT_OPENMVS=C:\path\to\OpenMVS\vc17\x64\Release
# GAUSSIANCIRCUIT_DATABASE_URL=postgresql+psycopg://user:password@localhost/gaussiancircuit

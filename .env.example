GAUSSIANCIRCUIT_DATA_ROOT=data
# Optional override; local development auto-detects the laptop LAN address.
# GAUSSIANCIRCUIT_WEB_URL=http://192.168.1.20:5173
GAUSSIANCIRCUIT_RECONSTRUCTION_ROOT=data/reconstructions
